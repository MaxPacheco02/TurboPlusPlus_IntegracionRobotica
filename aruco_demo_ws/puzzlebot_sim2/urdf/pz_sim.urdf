<?xml version="1.0"?> 

<robot name="puzzlebot">

    <link name="base_footprint">
    </link>

    <link name="base_link">
        <visual>
            <origin xyz="0.05 0 0.1" rpy="1.57 0 3.1416"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim2/meshes/MCR2_puzzlebot_jetson_lidar_base.stl" scale="1 1 1"/>  
            </geometry>
            <material name="yellow">
                <color rgba="0.8 0.8 0.05 1.0"/>
            </material>
        </visual>
    </link>

    <link name="wheel_r">
        <visual>
            <origin xyz="0.055 0 0" rpy="1.57 0 0"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim2/meshes/MCR2_wheel.stl" scale="1 1 1"/>  
            </geometry>
            <material name="yellow">
                <color rgba="0.8 0.8 0.05 1.0"/>
            </material>
        </visual>
    </link>

    <link name="wheel_l">
        <visual>
            <origin xyz="-0.055 0 0" rpy="1.57 0  3.1416"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim2/meshes/MCR2_wheel.stl" scale="1 1 1"/>  
            </geometry>
            <material name="yellow">
                <color rgba="0.8 0.8 0.05 1.0"/>
            </material>
        </visual>
    </link>

    <link name="caster">
        <visual>
            <origin xyz="0 0 -0.01" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://puzzlebot_sim2/meshes/MCR2_caster_wheel.stl" scale="1 1 1"/>  
            </geometry>
            <material name="yellow">
                <color rgba="0.8 0.8 0.05 1.0"/>
            </material>
        </visual>
    </link>

    <!-- <link name="camera">
    </link> -->

    <joint name="joint2" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.05" rpy="0 0 0" />
    </joint>

    <joint name="joint3" type="continuous">
        <parent link="base_link" />
        <child link="wheel_r" />
        <origin xyz="0.052 -0.095 -0.0025" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>
    
    <joint name="joint4" type="continuous">
        <parent link="base_link" />
        <child link="wheel_l" />
        <origin xyz="0.052 0.095 -0.0025" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="joint5" type="fixed">
        <parent link="base_link" />
        <child link="caster" />
        <origin xyz="-0.095 0 -0.03" rpy="0 0 0" />
    </joint> 


    <!-- <joint name="joint6" type="fixed">
        <parent link="base_link" />
        <child link="camera" />
        <origin xyz="0.11 0 0.07" rpy="0 0 0" />
    </joint>  -->

</robot> 