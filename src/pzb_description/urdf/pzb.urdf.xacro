<?xml version="1.0"?>
<robot name="puzzlebot" xmlns:xacro="http://ros.org/wiki/xacro">


<xacro:property name="off_ground" value="0.07" />
<xacro:property name="b_width" value="0.188" />
<xacro:property name="b_length" value="0.188" />
<xacro:property name="b_height" value="0.095" />
<xacro:property name="wheeldiam" value="0.160" />
<xacro:property name="caster_radius" value="0.03" />


<material name="blue">
  <color rgba="0 0 0.8 0.7"/>
</material>

<material name="black">
  <color rgba="0.1 0.1 0.1 1"/>
</material>

<material name="red">
  <color rgba="1 0 0 0 1"/>
</material>


<link name="odom">
  <joint name="odom" type="fixed">
    <axis xyz="0 0 0" rpy="0 0 0" />
    <parent link="map"/>
    <child link="odom"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</link>


<joint name="base_footprint_joint" type="planar">
  <axis xyz="0 0 0" rpy="0 0 0" />
  <parent link="odom"/>
  <child link="base_footprint"/>
  <origin xyz="0.5 0.25 0" rpy="0 0 0"/>
</joint>

<link name="base_footprint">
</link>

<joint name="base_link_joint" type="fixed"> -->
  <axis xyz="0 0 0" rpy="0 0 0" />
  <parent link="base_footprint"/>
  <child link="base_link"/>
  <origin xyz="0 0 ${off_ground}" rpy="0 0 0"/>
</joint>

<link name="base_link">
    <visual>
      <geometry>
        <box size="${b_width} ${b_length} ${b_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="blue"/>
    </visual>
</link>


<xacro:macro name="wheel" params="prefix reflect">
  <joint name="${prefix}_wheel_joint" type="continuous">
    <axis xyz="0.0 0.0 1" rpy="0 0 0" />
    <parent link="base_link"/>
    <child link="${prefix}_wheel"/>
    <origin xyz="${b_width*0.2} ${b_length*0.6*reflect} 0" rpy="${pi/2} 0 0" />
  </joint>

  <link name="${prefix}_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${wheeldiam/2}" length="0.02"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
</xacro:macro>

<xacro:wheel prefix="right" reflect="1"/>
<xacro:wheel prefix="left" reflect="-1"/>

<joint name="caster_joing" type="fixed"> -->
  <axis xyz="0 0 0" rpy="0 0 0" />
  <parent link="base_link"/>
  <child link="caster_link"/>
  <origin xyz="-${b_length*0.3} 0 ${-b_height/2}" rpy="0 0 0"/>
</joint>

<link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="black"/>
    </visual>
</link>



</robot>
