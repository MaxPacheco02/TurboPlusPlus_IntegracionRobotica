<?xml version="1.0" ?>
<sdf version="1.6">

<!--
Control differential speed straight from gz plugin
gz topic -t "/pzb_gz_drive" -m gz.msgs.Twist -p "linear: {x: 0.1} angular: {z: 0.0}"
-->

  <model name="puzzlebot">
    <pose>0 0 0.07 0 0 0</pose>
    
    <!-- Base Link -->
    <link name="base_link">
      <visual name="base_visual">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://pzb/meshes/pzb_lidar.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="base_collision">
        <pose>0 0 0 -1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>file://pzb/meshes/pzb_lidar.dae</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.01</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.01</iyy>
          <iyz>0</iyz>
          <izz>0.01</izz>
        </inertia>
      </inertial>

      <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose>0 0 0 0 0 0</pose>
        <topic>lidar</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-3.14</min_angle>
              <max_angle>3.14</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-1</min_angle>
              <max_angle>1</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.2</min>
            <max>20.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <alwaysOn>1</alwaysOn>
        <visualize>true</visualize>
        <plugin
          filename="RosGzPointCloud"
          name="ros_gz_point_cloud::PointCloud">
          <namespace>custom_params</namespace>
          <topic>pc2</topic>
          <frame_id>custom_params/link</frame_id>
        </plugin>
      </sensor>      
    </link>

    <!-- Right Wheel -->
    <link name="right_wheel">
      <pose>0.052 0.095 0.0 1.5708 0 0</pose>
      <visual name="right_wheel_visual">
        <geometry>
          <mesh>
            <uri>file://pzb/meshes/Puzzlebot_Wheel.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="right_wheel_collision">
        <geometry>
          <mesh>
            <uri>file://pzb/meshes/Puzzlebot_Wheel.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Left Wheel -->
    <link name="left_wheel">
      <pose>0.052 -0.095 0.0 -1.5708 0 0</pose>
      <visual name="left_wheel_visual">
        <geometry>
          <mesh>
            <uri>file://pzb/meshes/Puzzlebot_Wheel.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <collision name="left_wheel_collision">
        <geometry>
          <mesh>
            <uri>file://pzb/meshes/Puzzlebot_Wheel.stl</uri>
            <scale>1 1 1</scale>
          </mesh>
        </geometry>
      </collision>
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <!-- Lidar Link -->
    <link name="lidar_link">
      <!-- <pose>0 0 0 0 0 0</pose> -->
    </link>


    <!-- Right Wheel Joint -->
    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <pose>0 0 0 3.14159 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.9</erp>
          </limit>
        </ode>
      </physics>
    </joint>

    <!-- Left Wheel Joint -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
      </axis>
      <physics>
        <ode>
          <limit>
            <cfm>0</cfm>
            <erp>0.9</erp>
          </limit>
        </ode>
      </physics>
    </joint>

    <!-- Lidar Joint -->
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>lidar_link</child>
      <pose>0.052 0 0.1 0 0 0</pose>
    </joint>

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <topic>/pzb_gz_drive</topic>
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <odom_covariance_topic>/pzb/odom</odom_covariance_topic>
      <robot_base_frame>lidar_link</robot_base_frame>
    </plugin>

    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <topic>/gz_joints</topic>
    </plugin>

  </model>
</sdf>